DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Auth cookies: True in production (HTTPS). Defaults to "not DEBUG".
AUTH_COOKIE_SECURE=False
# Parent domain if the API and frontend are on different subdomains, e.g. .example.org
AUTH_COOKIE_DOMAIN=
