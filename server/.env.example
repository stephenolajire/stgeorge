DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Auth cookies: True in production (HTTPS). Defaults to "not DEBUG".
AUTH_COOKIE_SECURE=False
# Parent domain if the API and frontend are on different subdomains, e.g. .example.org
AUTH_COOKIE_DOMAIN=
# Live updates. Docker Compose sets this to its Redis service; leave it unset to use
# an in-memory layer (only works with one server process, fine for development).
# REDIS_URL=redis://localhost:6379/0
# Email (ZeptoMail). Without ZEPTOMAIL_API_KEY emails are printed to the console.
ZEPTOMAIL_API_KEY=
# API address for your ZeptoMail region (.com, .eu, .in, .com.au, ...)
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Sender: an address on a domain you verified in ZeptoMail
DEFAULT_FROM_EMAIL=St. George Catholic Church <noreply@yourdomain.org>
# Parish inbox that gets an email for each new contact-form message (leave empty for none)
CONTACT_NOTIFY_EMAIL=
# Where visitors' answers to our replies go (leave empty to use the sender address)
CONTACT_REPLY_TO=
# Public website address, used for links in emails
FRONTEND_URL=http://localhost:5173
